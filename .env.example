# ── Email provider ─────────────────────────────────────────────────
# Set to 'brevo' (default) or 'resend'
EMAIL_PROVIDER=brevo

# ── Brevo ───────────────────────────────────────────────────────────
# Get your API key from https://app.brevo.com → SMTP & API → API Keys
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Resend (only needed if EMAIL_PROVIDER=resend) ───────────────────
# Get your API key from https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Shared ──────────────────────────────────────────────────────────
# A secret key your frontend sends in the x-api-key header
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_SERVICE_API_KEY=your_random_secret_key_here

# The "from" address — must be a verified sender in Brevo / Resend
FROM_EMAIL=frNtcOda <noreply@frntcoda.com>

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://frntcoda.onrender.com,http://localhost:5500
