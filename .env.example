# Get your API key from https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# A secret key your frontend sends in the x-api-key header
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_SERVICE_API_KEY=your_random_secret_key_here

# The "from" address — must match a domain verified in Resend
# Free tier: you can use onboarding@resend.dev to test before verifying your domain
FROM_EMAIL=frNtcOda <noreply@frntcoda.com>

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://frntcoda.onrender.com,http://localhost:5500
