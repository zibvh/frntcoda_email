# ── Active provider ────────────────────────────────────────────────
# brevo  → no domain needed, sends to anyone (recommended while you don't have a domain)
# resend → requires a verified domain, use once you have one
EMAIL_PROVIDER=brevo

# ── Brevo ──────────────────────────────────────────────────────────
# Get your API key from https://app.brevo.com → SMTP & API → API Keys
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Resend ─────────────────────────────────────────────────────────
# Get your API key from https://resend.com → API Keys
# Only used when EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Shared ─────────────────────────────────────────────────────────
# A secret key your frontend sends in the x-api-key header
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_SERVICE_API_KEY=your_random_secret_key_here

# The "from" address.
# Brevo: use your verified Gmail (frntcoda@gmail.com) — no domain needed
# Resend: must match a domain verified in Resend dashboard
FROM_EMAIL=frNtcOda <frntcoda@gmail.com>

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://frntcoda.onrender.com,http://localhost:5500
